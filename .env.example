# LoveByte — environment variables
#
# Copy to .env.local and fill in. NEVER commit .env.local.
#
# Sources:
#   - NEXT_PUBLIC_* : read by both server and browser (anon-safe values only)
#   - everything else: server-only (Supabase service role, etc.)

# ─── Supabase Cloud project ────────────────────────────────────────────────
# Create at https://supabase.com/dashboard, then paste values here.
# NEXT_PUBLIC_* values are safe to ship to the browser (anon key, URL).
# The server-side Secret key MUST stay server-only — never NEXT_PUBLIC_.
#
# As of 2024, Supabase renamed `service_role` JWS keys to `Secret` keys
# (format `sb_secret_...`). Use the new key under SUPABASE_SECRET_KEY.
# Get it from: Supabase Dashboard → Project Settings → API → Secret keys.
# The old `eyJ...` service_role JWT is deprecated for new projects.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-key
SUPABASE_SECRET_KEY=sb_secret_...your-secret-key

# ─── Open-design (host-side proxy for design mirroring) ────────────────────
# Used by `od artifacts create` from the host. Not read by the Next app.

OPEN_DESIGN_URL=http://127.0.0.1:7456

# ─── Vercel ────────────────────────────────────────────────────────────────
# Set via `vercel link` + `vercel env add`. No values needed in this file.
# When the Supabase Cloud project is created, push these to Vercel:
#   vercel env add NEXT_PUBLIC_SUPABASE_URL production
#   vercel env add NEXT_PUBLIC_SUPABASE_ANON_KEY production
#   vercel env add SUPABASE_SECRET_KEY production

# ─── Stripe (M-E, OOP-4277) ───────────────────────────────────────────────
# Stripe Connect destination charges + webhook.
# Get the secret from: Stripe Dashboard → Developers → API keys.
# Use the TEST-mode key (sk_test_…) during local + pre-launch work.
# Get the webhook signing secret from: Stripe Dashboard → Developers →
# Webhooks → Add endpoint → Reveal signing secret (whsec_…). The endpoint
# URL is https://lovebyte-five.vercel.app/api/stripe/webhook.
#
# These two envs must also be pushed to Vercel via:
#   vercel env add STRIPE_SECRET_KEY production
#   vercel env add STRIPE_WEBHOOK_SECRET production

STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Email (M-E, OOP-4277) ────────────────────────────────────────────────
# Resend transactional email for share-link delivery. Without this set,
# src/lib/email.ts falls back to console.log (dev/staging only — production
# MUST set RESEND_API_KEY or email will silently no-op).
# Get from: https://resend.com/api-keys
# RESEND_FROM must be a verified sender domain in your Resend account.

RESEND_API_KEY=re_...
RESEND_FROM="LoveByte <hello@lovebyte.app>"
